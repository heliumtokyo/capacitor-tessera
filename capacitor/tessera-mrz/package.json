{
  "name": "capacitor-tessera-mrz",
  "version": "0.1.0",
  "description": "Capacitor adapter for native Tessera MRZ scanning",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift"
  ],
  "author": "Tessera contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightine-io/tessera.git",
    "directory": "capacitor/tessera-mrz"
  },
  "keywords": [
    "capacitor",
    "mrz",
    "passport",
    "identity-document"
  ],
  "scripts": {
    "verify": "npm run lint && npm run test && npm run build",
    "lint": "npm run eslint && npm run prettier -- --check",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "test": "vitest run",
    "docgen": "docgen --api TesseraMrzPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.5.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "rollup": "^4.63.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0 <9.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
